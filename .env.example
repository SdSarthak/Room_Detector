# Copy to .env and adjust. Every value here is a placeholder.
# Real environment variables always take precedence over this file.

# --- Paths ---------------------------------------------------------------
ROOM_DETECTOR_DATA_DIR=data
ROOM_DETECTOR_MODEL_PATH=models/room_classifier.joblib

# --- Serial capture ------------------------------------------------------
# Windows: COM3 / COM4 ... | Linux: /dev/ttyUSB0 | macOS: /dev/cu.usbserial-0001
ROOM_DETECTOR_SERIAL_PORT=COM3
ROOM_DETECTOR_BAUDRATE=921600
ROOM_DETECTOR_SERIAL_TIMEOUT=1.0

# --- Preprocessing -------------------------------------------------------
# Keep only the 52 data subcarriers of the 20 MHz LLTF symbol.
ROOM_DETECTOR_DATA_SUBCARRIERS_ONLY=true
ROOM_DETECTOR_DROP_NULL_SUBCARRIERS=true
# Hampel outlier filter; 0 disables it.
ROOM_DETECTOR_HAMPEL_WINDOW=5
ROOM_DETECTOR_HAMPEL_SIGMAS=3.0
# Moving-average smoothing; 0 or 1 disables it.
ROOM_DETECTOR_SMOOTH_WINDOW=3
# Remove the linear phase ramp from sampling/frequency offsets.
ROOM_DETECTOR_SANITIZE_PHASE=true
# none | l2 | zscore | minmax
ROOM_DETECTOR_NORMALIZE=none

# --- Windowing and features ---------------------------------------------
ROOM_DETECTOR_WINDOW_SIZE=64
ROOM_DETECTOR_WINDOW_STEP=32
ROOM_DETECTOR_USE_AMPLITUDE=true
ROOM_DETECTOR_USE_PHASE=true
ROOM_DETECTOR_USE_RSSI=true
ROOM_DETECTOR_USE_MOTION=true

# --- Model ---------------------------------------------------------------
# random_forest | extra_trees | svm | knn | logistic
ROOM_DETECTOR_ALGORITHM=random_forest
ROOM_DETECTOR_N_ESTIMATORS=300
ROOM_DETECTOR_C=10.0
ROOM_DETECTOR_N_NEIGHBORS=5
ROOM_DETECTOR_RANDOM_STATE=42
ROOM_DETECTOR_CV_FOLDS=5

# --- Live prediction -----------------------------------------------------
ROOM_DETECTOR_VOTE_WINDOW=3
ROOM_DETECTOR_MIN_CONFIDENCE=0.0
